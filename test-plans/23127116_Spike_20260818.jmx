if (!(parsed instanceof Map) || parsed.message != 'Coupon created' || !parsed.containsKey('id') || parsed.id == null) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Expected exact Coupon created message and non-null top-level id') }</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223Assertion>
          <hashTree/>
        </hashTree>
